    {
      "title": "Heat the cast iron",
      "text": "Set a cast-iron pan on the grill over high heat and let it get very hot.",
      "uses": []
    },
    {
      "title": "Cook the meat",
      "text": "Sear the steak in batches if needed, about 4 to 5 minutes a side, to 130°F for medium-rare.",
